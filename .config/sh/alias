# ssh
function revert_colors_after_ssh() {
  ssh "$@" 
  exit_status=$?
  if [ -f $XDG_CONFIG_HOME/sh/colorscheme ]; then
    (cat $XDG_CONFIG_HOME/sh/colorscheme &)
  fi
  return $exit_status
}
alias ssh="revert_colors_after_ssh"

