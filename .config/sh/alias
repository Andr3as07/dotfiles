# notes
note() {
  local dir="$HOME/Obsidian/Quicknotes"
  local file="$dir/$(date +%Y-%m-%d_%H%M%S).md"
  mkdir -p "$dir"
  echo "# $(date +%Y-%m-%d\ %H:%M:%S)" > "$file"
  echo "" >> "$file"
  if [ $# -eq 0 ]; then
    ${EDITOR} "$file"
  else
    echo "$*" >> "$file"
    echo "saved: $file"
  fi
}

