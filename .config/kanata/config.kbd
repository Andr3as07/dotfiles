;; defsrc is still necessary
(defcfg
  process-unmapped-keys yes
)

;; Define the non-us key "ö"
(deflocalkeys-linux
  ö 59
)

(defsrc
  caps a s d f j k l ö f23
)

(defvar
  tap-time 150
  hold-time 200
)

(defalias
  escctrl (tap-hold $tap-time $hold-time esc lctl)
  a (tap-hold $tap-time $hold-time a lmet)
  s (tap-hold $tap-time $hold-time s ralt)
  d (tap-hold $tap-time $hold-time d lsft)
  f (tap-hold $tap-time $hold-time f lctl)
  j (tap-hold $tap-time $hold-time j rctl)
  k (tap-hold $tap-time $hold-time k rsft)
  l (tap-hold $tap-time $hold-time l ralt)
  ; (tap-hold $tap-time $hold-time ö rmet)
  copilot (tap-hold $tap-time $hold-time f23 rctl)
)

(deflayer base
  @escctrl @a @s @d @f @j @k @l @; @copilot
)
